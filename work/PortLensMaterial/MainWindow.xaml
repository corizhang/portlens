<Window x:Class="PortLensMaterial.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="PortLens"
        Width="780"
        Height="760"
        MinWidth="680"
        MinHeight="560"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/portlens-icon.ico"
        Background="#F7F2EC">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style x:Key="PortActionButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
        <Style x:Key="SearchTextBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="Height" Value="52" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="12,0,12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="materialDesign:TextFieldAssist.DecorationVisibility" Value="Hidden" />
        </Style>
        <Style x:Key="MetaIcon" TargetType="materialDesign:PackIcon">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Foreground" Value="#9A8F86" />
            <Setter Property="Margin" Value="0,1,4,0" />
        </Style>
    </Window.Resources>

    <materialDesign:DialogHost Identifier="RootDialog"
                               DialogTheme="Inherit"
                               CloseOnClickAway="False">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top"
                Background="#F7F2EC"
                BorderBrush="#E2D8CE"
                BorderThickness="0,0,0,1"
                Padding="24,18,18,14"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid>
                <Grid Margin="0,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="250" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="#D85268" Margin="0,2,10,0" />
                        <TextBlock Text="PORTLENS" FontSize="11" FontWeight="SemiBold" Foreground="#9E5962" />
                    </StackPanel>

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="Ports"
                               FontFamily="Georgia"
                               FontSize="44"
                               FontWeight="Bold"
                               Foreground="#211B18"
                               Margin="0,14,34,0" />

                    <TextBox Grid.Row="1"
                             Grid.Column="1"
                             VerticalAlignment="Center"
                             Margin="0,10,0,0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Search localhost services"
                             Style="{StaticResource SearchTextBox}" />

                    <StackPanel Grid.Row="1"
                                Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Margin="24,10,0,0">
                        <TextBlock Text="System ports"
                                   Foreground="#6F655E"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <ToggleButton IsChecked="{Binding ShowSystemPorts}"
                                      Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                      VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Minimize" Width="32" Height="32" Click="MinimizeButton_Click">
                        <materialDesign:PackIcon Kind="Minus" Width="17" Height="17" />
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Hide to tray" Width="32" Height="32" Click="HideButton_Click">
                        <materialDesign:PackIcon Kind="Close" Width="17" Height="17" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="#F7F2EC"
                BorderBrush="#E2D8CE"
                BorderThickness="0,1,0,0"
                Padding="24,8,24,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <materialDesign:PackIcon Grid.Column="0"
                                         Kind="Radar"
                                         Width="16"
                                         Height="16"
                                         Foreground="#8A7F76"
                                         Margin="0,0,8,0"
                                         VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusText}"
                           Foreground="#7C716A"
                           FontSize="13"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Margin="24,8,24,8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding FilteredEntries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="Transparent" BorderBrush="#E4DAD0" BorderThickness="0,0,0,1" Padding="0" Margin="0">
                                <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource MaterialDesignExpander}"
                                          Padding="0">
                                    <Expander.Header>
                                        <Grid Margin="4,8,6,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="92" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding PortText}"
                                                       FontFamily="Consolas"
                                                       FontSize="20"
                                                       FontWeight="Bold"
                                                       Foreground="#3F7BC8"
                                                       VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="1" Margin="2,0,18,0">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="17"
                                                           FontWeight="SemiBold"
                                                           Foreground="#2C2622"
                                                           TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                                        <materialDesign:PackIcon Kind="ApplicationBracesOutline" Style="{StaticResource MetaIcon}" />
                                                        <TextBlock Text="{Binding FrameworkText}" Foreground="#7B7169" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                                        <materialDesign:PackIcon Kind="ClockOutline" Style="{StaticResource MetaIcon}" />
                                                        <TextBlock Text="{Binding UptimeText}" Foreground="#7B7169" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                                        <materialDesign:PackIcon Kind="Cpu64Bit" Style="{StaticResource MetaIcon}" />
                                                        <TextBlock Text="{Binding CpuText}" Foreground="#7B7169" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Memory" Style="{StaticResource MetaIcon}" />
                                                        <TextBlock Text="{Binding MemoryText}" Foreground="#7B7169" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource PortActionButton}" Click="OpenButton_Click" Tag="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="OpenInNew" Width="16" Height="16" Margin="0,0,6,0" />
                                                        <TextBlock Text="Open" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource PortActionButton}" Click="CopyButton_Click" Tag="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="ContentCopy" Width="16" Height="16" Margin="0,0,6,0" />
                                                        <TextBlock Text="Copy" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Expander.Header>

                                    <Grid Margin="36,0,6,14">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="50" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,18,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="86" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="PID" Foreground="#A89D94" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ProcessId}" Foreground="#4E4640" />

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Address" Foreground="#A89D94" Margin="0,7,0,0" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AddressText}" Foreground="#4E4640" Margin="0,7,0,0" />

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Command" Foreground="#A89D94" Margin="0,7,0,0" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CommandText}" Foreground="#4E4640" Margin="0,7,0,0" TextWrapping="Wrap" />

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Directory" Foreground="#A89D94" Margin="0,7,0,0" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DirectoryText}" Foreground="#4E4640" Margin="0,7,0,0" TextWrapping="Wrap" />
                                        </Grid>

                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                            <Button Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0" Click="OpenDirectoryButton_Click" Tag="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="FolderOpenOutline" Width="16" Height="16" Margin="0,0,6,0" />
                                                    <TextBlock Text="Directory" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0" Click="CopyPidButton_Click" Tag="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Identifier" Width="16" Height="16" Margin="0,0,6,0" />
                                                    <TextBlock Text="PID" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#B3261E" Click="KillButton_Click" Tag="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="StopCircleOutline" Width="16" Height="16" Margin="0,0,6,0" />
                                                    <TextBlock Text="Kill" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <Grid Grid.Row="1" Grid.Column="2" Width="50" IsHitTestVisible="False" Opacity="0" />
                                    </Grid>
                                </Expander>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                <materialDesign:PackIcon Kind="LanDisconnect" Width="48" Height="48" Foreground="#B6A99F" HorizontalAlignment="Center" />
                <TextBlock Text="No development services found" FontSize="18" FontWeight="SemiBold" Foreground="#6B625C" Margin="0,12,0,0" />
                <TextBlock Text="Start a dev server, or enable System ports." Foreground="#8C8178" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>
    </DockPanel>
    </materialDesign:DialogHost>
</Window>
