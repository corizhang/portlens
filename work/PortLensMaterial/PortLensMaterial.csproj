<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PortLensMaterial</AssemblyName>
    <RootNamespace>PortLensMaterial</RootNamespace>
    <ApplicationIcon>Assets\portlens-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\PortLens\Models\*.cs" Link="Models\%(Filename)%(Extension)" />
    <Compile Include="..\PortLens\Services\*.cs" Link="Services\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\portlens-icon.ico" />
    <Resource Include="Assets\portlens-icon.png" />
  </ItemGroup>
</Project>
