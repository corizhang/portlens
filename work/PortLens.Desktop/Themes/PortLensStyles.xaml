<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

    <Style x:Key="PortActionButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Margin" Value="6,0,0,0" />
    </Style>

    <Style x:Key="SearchTextBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
        <Setter Property="Height" Value="52" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="12,0,12,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="materialDesign:TextFieldAssist.DecorationVisibility" Value="Hidden" />
    </Style>

    <Style x:Key="MetaIcon" TargetType="materialDesign:PackIcon">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource PortLensMetaIconBrush}" />
        <Setter Property="Margin" Value="0,1,4,0" />
    </Style>
</ResourceDictionary>
