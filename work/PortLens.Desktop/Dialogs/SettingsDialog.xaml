<UserControl x:Class="PortLens.Desktop.Dialogs.SettingsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="560"
             MaxHeight="680"
             Margin="24">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,16">
            <materialDesign:PackIcon Kind="CogOutline"
                                     Width="28"
                                     Height="28"
                                     Foreground="{StaticResource PortLensSettingsIconBrush}"
                                     Margin="0,0,12,0" />
            <TextBlock Text="Settings"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PortLensDialogTitleBrush}"
                       VerticalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="1"
              MinHeight="360">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Margin="0,0,0,14">
                <Button x:Name="GeneralTabButton"
                        Content="General"
                        MinWidth="112"
                        Height="34"
                        Margin="0,0,8,0"
                        Padding="12,0"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Click="GeneralTabButton_Click" />
                <Button x:Name="RulesTabButton"
                        Content="Rules"
                        MinWidth="112"
                        Height="34"
                        Margin="0,0,8,0"
                        Padding="12,0"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Click="RulesTabButton_Click" />
                <Button x:Name="BlacklistTabButton"
                        MinWidth="112"
                        Height="34"
                        Margin="0,0,8,0"
                        Padding="12,0"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Click="BlacklistTabButton_Click" />
            </StackPanel>

            <Grid Grid.Row="1">
                <ScrollViewer x:Name="GeneralPage"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,18,0,0">
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="System ports"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PortLensSectionTitleBrush}" />
                                <TextBlock Text="Include non-development listening ports."
                                           FontSize="12"
                                           Foreground="{StaticResource PortLensTextBrush}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <ToggleButton x:Name="ShowSystemPortsToggle"
                                          Grid.Column="1"
                                          Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                          VerticalAlignment="Center" />
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="Refresh interval"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PortLensSectionTitleBrush}" />
                                <TextBlock Text="How often PortLens scans in the background."
                                           FontSize="12"
                                           Foreground="{StaticResource PortLensTextBrush}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <ComboBox x:Name="RefreshIntervalCombo"
                                      Grid.Column="1"
                                      Width="128"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                <ComboBoxItem Content="3 seconds" Tag="3" />
                                <ComboBoxItem Content="5 seconds" Tag="5" />
                                <ComboBoxItem Content="10 seconds" Tag="10" />
                                <ComboBoxItem Content="30 seconds" Tag="30" />
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="Window placement"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PortLensSectionTitleBrush}" />
                                <TextBlock Text="Restore size and position on launch."
                                           FontSize="12"
                                           Foreground="{StaticResource PortLensTextBrush}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <ToggleButton x:Name="RememberPlacementToggle"
                                          Grid.Column="1"
                                          Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                          VerticalAlignment="Center" />
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="Close behavior"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PortLensSectionTitleBrush}" />
                                <TextBlock Text="Hide to tray when the close button is used."
                                           FontSize="12"
                                           Foreground="{StaticResource PortLensTextBrush}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <ToggleButton x:Name="CloseToTrayToggle"
                                          Grid.Column="1"
                                          Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                          VerticalAlignment="Center" />
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="Group by project"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PortLensSectionTitleBrush}" />
                                <TextBlock Text="Group sibling services by inferred project root."
                                           FontSize="12"
                                           Foreground="{StaticResource PortLensTextBrush}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <ToggleButton x:Name="GroupByProjectToggle"
                                          Grid.Column="1"
                                          Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                          VerticalAlignment="Center" />
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="Status metrics"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PortLensSectionTitleBrush}" />
                                <TextBlock Text="Show PortLens CPU and memory in the status bar."
                                           FontSize="12"
                                           Foreground="{StaticResource PortLensTextBrush}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <ToggleButton x:Name="ShowAppMetricsToggle"
                                          Grid.Column="1"
                                          Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                          VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="PortLens - local development port monitor"
                                   Foreground="{StaticResource PortLensTextBrush}"
                                   FontSize="12"
                                   Margin="0,18,0,0" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="RulesPage"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,10,0,14">
                        <TextBlock Text="Development rules"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PortLensSectionTitleBrush}"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="These rules decide which recognized services appear when System ports is off."
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource PortLensTextBrush}"
                                   FontSize="12"
                                   Margin="0,0,0,16" />
                        <UniformGrid x:Name="FrameworkRulesGrid"
                                     Columns="3" />
                    </StackPanel>
                </ScrollViewer>

                <DockPanel x:Name="BlacklistPage"
                           Visibility="Collapsed"
                           Margin="0,10,0,0"
                           LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top"
                                Margin="0,0,0,12">
                        <TextBlock Text="Port blacklist"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PortLensSectionTitleBrush}"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="Blacklisted ports stay hidden even when System ports is enabled."
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource PortLensTextBrush}"
                                   FontSize="12" />
                    </StackPanel>
                    <ScrollViewer MaxHeight="280"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="BlacklistList" />
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="2"
              Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="Reset"
                    MinWidth="86"
                    Foreground="{StaticResource PortLensDangerBrush}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Click="ResetButton_Click" />
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Cancel"
                        MinWidth="86"
                        Margin="0,0,8,0"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" />
                <Button Content="Save"
                        MinWidth="86"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Click="SaveButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
