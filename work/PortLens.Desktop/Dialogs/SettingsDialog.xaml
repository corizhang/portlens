<UserControl x:Class="PortLens.Desktop.Dialogs.SettingsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:loc="clr-namespace:PortLens.Desktop.Markup"
             xmlns:font="clr-namespace:PortLens.Desktop.Markup"
             Width="560"
             MaxHeight="680"
             FontFamily="{font:Font}"
             Loaded="SettingsDialog_Loaded"
             Margin="24">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,16">
            <materialDesign:PackIcon Kind="CogOutline"
                                     Width="28"
                                     Height="28"
                                     Foreground="{DynamicResource PortLensSettingsIconBrush}"
                                     Margin="0,0,12,0" />
            <TextBlock Text="{loc:Loc Key=SettingsTitle}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PortLensDialogTitleBrush}"
                       VerticalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="1"
              MinHeight="360"
              MaxHeight="520">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Margin="0,0,0,8">
                <Button x:Name="TabGeneralButton"
                        Content="{loc:Loc Key=TabGeneral}"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Background="Transparent"
                        BorderBrush="{DynamicResource PortLensBrandBrush}"
                        BorderThickness="0,0,0,2"
                        Foreground="{DynamicResource PortLensBrandBrush}"
                        Padding="16,8"
                        Click="TabButton_Click"
                        Tag="0" />
                <Button x:Name="TabRulesButton"
                        Content="{loc:Loc Key=TabRules}"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Background="Transparent"
                        BorderBrush="{DynamicResource PortLensBrandBrush}"
                        BorderThickness="0,0,0,0"
                        Foreground="{DynamicResource PortLensSubtitleBrush}"
                        Padding="16,8"
                        Click="TabButton_Click"
                        Tag="1" />
                <Button x:Name="TabBlacklistButton"
                        Content="{loc:Loc Key=TabBlacklist}"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Background="Transparent"
                        BorderBrush="{DynamicResource PortLensBrandBrush}"
                        BorderThickness="0,0,0,0"
                        Foreground="{DynamicResource PortLensSubtitleBrush}"
                        Padding="16,8"
                        Click="TabButton_Click"
                        Tag="2" />
                <Button x:Name="TabAboutButton"
                        Content="{loc:Loc Key=AboutTab}"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Background="Transparent"
                        BorderBrush="{DynamicResource PortLensBrandBrush}"
                        BorderThickness="0,0,0,0"
                        Foreground="{DynamicResource PortLensSubtitleBrush}"
                        Padding="16,8"
                        Click="TabButton_Click"
                        Tag="3" />
            </StackPanel>

            <Border Grid.Row="1"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource PortLensBorderBrush}"
                    Padding="0,8,0,0">
                <Grid x:Name="TabContentGrid">
                    <ScrollViewer x:Name="GeneralTabContent"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="Visible">
                        <StackPanel Margin="0,10,0,0">
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,20,0">
                                    <TextBlock Text="{loc:Loc Key=SettingSystemPortsTitle}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PortLensSectionTitleBrush}" />
                                    <TextBlock Text="{loc:Loc Key=SettingSystemPortsDescription}"
                                               FontSize="12"
                                               Foreground="{DynamicResource PortLensTextBrush}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <ToggleButton x:Name="ShowSystemPortsToggle"
                                              Grid.Column="1"
                                              Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                              VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,20,0">
                                    <TextBlock Text="{loc:Loc Key=SettingRefreshIntervalTitle}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PortLensSectionTitleBrush}" />
                                    <TextBlock Text="{loc:Loc Key=SettingRefreshIntervalDescription}"
                                               FontSize="12"
                                               Foreground="{DynamicResource PortLensTextBrush}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <ComboBox x:Name="RefreshIntervalCombo"
                                          Grid.Column="1"
                                          Width="128"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                    <ComboBoxItem Content="{loc:Loc Key=RefreshInterval3Seconds}" Tag="3" />
                                    <ComboBoxItem Content="{loc:Loc Key=RefreshInterval5Seconds}" Tag="5" />
                                    <ComboBoxItem Content="{loc:Loc Key=RefreshInterval10Seconds}" Tag="10" />
                                    <ComboBoxItem Content="{loc:Loc Key=RefreshInterval30Seconds}" Tag="30" />
                                </ComboBox>
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,20,0">
                                    <TextBlock Text="{loc:Loc Key=SettingWindowPlacementTitle}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PortLensSectionTitleBrush}" />
                                    <TextBlock Text="{loc:Loc Key=SettingWindowPlacementDescription}"
                                               FontSize="12"
                                               Foreground="{DynamicResource PortLensTextBrush}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <ToggleButton x:Name="RememberPlacementToggle"
                                              Grid.Column="1"
                                              Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                              VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,20,0">
                                    <TextBlock Text="{loc:Loc Key=SettingCloseBehaviorTitle}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PortLensSectionTitleBrush}" />
                                    <TextBlock Text="{loc:Loc Key=SettingCloseBehaviorDescription}"
                                               FontSize="12"
                                               Foreground="{DynamicResource PortLensTextBrush}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <ToggleButton x:Name="CloseToTrayToggle"
                                              Grid.Column="1"
                                              Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                              VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,20,0">
                                    <TextBlock Text="{loc:Loc Key=SettingGroupByProjectTitle}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PortLensSectionTitleBrush}" />
                                    <TextBlock Text="{loc:Loc Key=SettingGroupByProjectDescription}"
                                               FontSize="12"
                                               Foreground="{DynamicResource PortLensTextBrush}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <ToggleButton x:Name="GroupByProjectToggle"
                                              Grid.Column="1"
                                              Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                              VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,20,0">
                                    <TextBlock Text="{loc:Loc Key=SettingStatusMetricsTitle}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PortLensSectionTitleBrush}" />
                                    <TextBlock Text="{loc:Loc Key=SettingStatusMetricsDescription}"
                                               FontSize="12"
                                               Foreground="{DynamicResource PortLensTextBrush}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <ToggleButton x:Name="ShowAppMetricsToggle"
                                              Grid.Column="1"
                                              Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                              VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,20,0">
                                    <TextBlock Text="{loc:Loc Key=SettingThemeTitle}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PortLensSectionTitleBrush}" />
                                    <TextBlock Text="{loc:Loc Key=SettingThemeDescription}"
                                               FontSize="12"
                                               Foreground="{DynamicResource PortLensTextBrush}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <ComboBox x:Name="ThemeCombo"
                                          Grid.Column="1"
                                          Width="128"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                    <ComboBoxItem Content="{loc:Loc Key=ThemeLight}" Tag="Light" />
                                    <ComboBoxItem Content="{loc:Loc Key=ThemeDark}" Tag="Dark" />
                                </ComboBox>
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,20,0">
                                    <TextBlock Text="{loc:Loc Key=SettingLanguageTitle}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PortLensSectionTitleBrush}" />
                                    <TextBlock Text="{loc:Loc Key=SettingLanguageDescription}"
                                               FontSize="12"
                                               Foreground="{DynamicResource PortLensTextBrush}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <ComboBox x:Name="LanguageCombo"
                                          Grid.Column="1"
                                          Width="128"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                    <ComboBoxItem Content="{loc:Loc Key=LanguageEnglish}" Tag="en-US" />
                                    <ComboBoxItem Content="{loc:Loc Key=LanguageSimplifiedChinese}" Tag="zh-Hans" />
                                </ComboBox>
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,20,0">
                                    <TextBlock Text="{loc:Loc Key=SettingChineseFontTitle}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PortLensSectionTitleBrush}" />
                                    <TextBlock Text="{loc:Loc Key=SettingChineseFontDescription}"
                                               FontSize="12"
                                               Foreground="{DynamicResource PortLensTextBrush}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <ComboBox x:Name="ChineseFontCombo"
                                          Grid.Column="1"
                                          Width="160"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          VirtualizingStackPanel.IsVirtualizing="True"
                                          VirtualizingStackPanel.VirtualizationMode="Recycling" />
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,20,0">
                                    <TextBlock Text="{loc:Loc Key=SettingEnglishFontTitle}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PortLensSectionTitleBrush}" />
                                    <TextBlock Text="{loc:Loc Key=SettingEnglishFontDescription}"
                                               FontSize="12"
                                               Foreground="{DynamicResource PortLensTextBrush}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <ComboBox x:Name="EnglishFontCombo"
                                          Grid.Column="1"
                                          Width="160"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          VirtualizingStackPanel.IsVirtualizing="True"
                                          VirtualizingStackPanel.VirtualizationMode="Recycling" />
                            </Grid>

                            <TextBlock Text="{loc:Loc Key=AppSubtitle}"
                                       Foreground="{DynamicResource PortLensTextBrush}"
                                       FontSize="12"
                                       Margin="0,18,0,0" />
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="AboutTabContent"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="Collapsed">
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="PortLens"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PortLensDialogTitleBrush}"
                                       Margin="0,0,0,8" />
                            <TextBlock Text="{loc:Loc Key=AboutDescription}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource PortLensTextBrush}"
                                       FontSize="13"
                                       Margin="0,0,0,20" />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Image x:Name="VersionBadge"
                                       Height="20"
                                       Margin="0,0,8,0"
                                       Cursor="Hand"
                                       MouseLeftButtonUp="VersionBadge_Click" />
                                <Image x:Name="LatestVersionBadge"
                                       Height="20"
                                       Margin="0,0,8,0"
                                       Cursor="Hand"
                                       MouseLeftButtonUp="LatestVersionBadge_Click" />
                                <Image x:Name="LicenseBadge"
                                       Height="20"
                                       Cursor="Hand"
                                       MouseLeftButtonUp="LicenseBadge_Click" />
                            </StackPanel>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{loc:Loc Key=AboutAuthor}"
                                           Foreground="{DynamicResource PortLensSubtitleBrush}"
                                           FontSize="13" />
                                <TextBlock Grid.Column="1"
                                           Text="{loc:Loc Key=AboutAuthorValue}"
                                           Foreground="{DynamicResource PortLensTextBrush}"
                                           FontSize="13" />
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{loc:Loc Key=AboutProjectUrl}"
                                           Foreground="{DynamicResource PortLensSubtitleBrush}"
                                           FontSize="13" />
                                <Image Grid.Column="1"
                                       x:Name="ProjectUrlBadge"
                                       Height="20"
                                       HorizontalAlignment="Left"
                                       Cursor="Hand"
                                       MouseLeftButtonUp="ProjectUrlBadge_Click" />
                            </Grid>

                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{loc:Loc Key=AboutVersion}"
                                           Foreground="{DynamicResource PortLensSubtitleBrush}"
                                           FontSize="13" />
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="AboutVersionText"
                                               Foreground="{DynamicResource PortLensTextBrush}"
                                               FontSize="13"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="AboutLatestVersionText"
                                               Foreground="{DynamicResource PortLensSubtitleBrush}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0" />
                                </StackPanel>
                            </Grid>

                            <Button x:Name="CheckUpdateButton"
                                    Content="{loc:Loc Key=AboutCheckUpdate}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Click="CheckUpdateButton_Click"
                                    HorizontalAlignment="Left"
                                    MinWidth="120"
                                    Margin="0,0,0,12" />

                            <TextBlock x:Name="AboutUpdateStatusText"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource PortLensTextBrush}"
                                       FontSize="12"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="RulesTabContent"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="Collapsed">
                        <StackPanel Margin="0,10,0,14">
                            <TextBlock Text="{loc:Loc Key=RulesTitle}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PortLensSectionTitleBrush}"
                                       Margin="0,0,0,8" />
                            <TextBlock Text="{loc:Loc Key=RulesDescription}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource PortLensTextBrush}"
                                       FontSize="12"
                                       Margin="0,0,0,16" />
                            <UniformGrid x:Name="FrameworkRulesGrid"
                                         Columns="3" />
                        </StackPanel>
                    </ScrollViewer>

                    <DockPanel x:Name="BlacklistTabContent"
                               Margin="0,10,0,0"
                               LastChildFill="True"
                               Visibility="Collapsed">
                        <StackPanel DockPanel.Dock="Top"
                                    Margin="0,0,0,12">
                            <TextBlock Text="{loc:Loc Key=BlacklistTitle}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PortLensSectionTitleBrush}"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="{loc:Loc Key=BlacklistDescription}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource PortLensTextBrush}"
                                       FontSize="12" />
                        </StackPanel>
                        <ScrollViewer MaxHeight="280"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="BlacklistList" />
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2"
              Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="{loc:Loc Key=ButtonReset}"
                    MinWidth="86"
                    Foreground="{DynamicResource PortLensDangerBrush}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Click="ResetButton_Click" />
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="{loc:Loc Key=ButtonCancel}"
                        MinWidth="86"
                        Margin="0,0,8,0"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" />
                <Button Content="{loc:Loc Key=ButtonSave}"
                        MinWidth="86"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Click="SaveButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
