<Window x:Class="PortLens.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="PortLens"
        Width="780"
        Height="760"
        MinWidth="680"
        MinHeight="560"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/portlens-icon.ico"
        Background="{StaticResource PortLensBackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary />
    </Window.Resources>

    <materialDesign:DialogHost Identifier="RootDialog"
                               DialogTheme="Inherit"
                               CloseOnClickAway="False">
    <Grid>
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top"
                Background="{StaticResource PortLensBackgroundBrush}"
                BorderBrush="{StaticResource PortLensBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,18,18,14"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid>
                <Grid Margin="0,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="250" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource PortLensStatusDotBrush}" Margin="0,2,10,0" />
                        <TextBlock Text="PORTLENS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PortLensBrandBrush}" />
                    </StackPanel>

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="Ports"
                               FontFamily="Georgia"
                               FontSize="44"
                               FontWeight="Bold"
                               Foreground="{StaticResource PortLensTitleBrush}"
                               Margin="0,14,34,0" />

                    <TextBox Grid.Row="1"
                             Grid.Column="1"
                             VerticalAlignment="Center"
                             Margin="0,10,0,0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Search localhost services"
                             Style="{StaticResource SearchTextBox}" />

                    <StackPanel Grid.Row="1"
                                Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Margin="24,10,0,0">
                        <TextBlock Text="System ports"
                                   Foreground="{StaticResource PortLensLabelBrush}"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <ToggleButton IsChecked="{Binding ShowSystemPorts}"
                                      Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                      VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Settings" Width="32" Height="32" Click="SettingsButton_Click">
                        <materialDesign:PackIcon Kind="CogOutline" Width="17" Height="17" />
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Minimize" Width="32" Height="32" Click="MinimizeButton_Click">
                        <materialDesign:PackIcon Kind="Minus" Width="17" Height="17" />
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Hide to tray" Width="32" Height="32" Click="HideButton_Click">
                        <materialDesign:PackIcon Kind="Close" Width="17" Height="17" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource PortLensBackgroundBrush}"
                BorderBrush="{StaticResource PortLensBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,8,24,8"
                Cursor="Hand"
                ToolTip="Open settings"
                MouseLeftButtonUp="StatusBar_MouseLeftButtonUp">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <materialDesign:PackIcon Grid.Column="0"
                                         Kind="Radar"
                                         Width="16"
                                         Height="16"
                                         Foreground="{StaticResource PortLensSubtitleBrush}"
                                         Margin="0,0,8,0"
                                         VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusText}"
                           Foreground="{StaticResource PortLensTextBrush}"
                           FontSize="13"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0">
                    <TextBlock Text="{Binding ServiceCountText}"
                               Foreground="{StaticResource PortLensTextBrush}"
                               FontSize="13"
                               VerticalAlignment="Center" />
                    <TextBlock Text="  |  "
                               Foreground="{StaticResource PortLensSeparatorBrush}"
                               FontSize="13"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding LastScanText}"
                               Foreground="{StaticResource PortLensTextBrush}"
                               FontSize="13"
                               VerticalAlignment="Center" />
                    <TextBlock Text="  |  "
                               Foreground="{StaticResource PortLensSeparatorBrush}"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Visibility="{Binding ShowAppMetrics, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <materialDesign:PackIcon Kind="ChartTimelineVariant"
                                             Width="15"
                                             Height="15"
                                             Foreground="{StaticResource PortLensSubtitleBrush}"
                                             Margin="0,0,5,0"
                                             VerticalAlignment="Center"
                                             Visibility="{Binding ShowAppMetrics, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock Text="{Binding AppResourceText}"
                               Foreground="{StaticResource PortLensTextBrush}"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Visibility="{Binding ShowAppMetrics, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock Text="  |  "
                               Foreground="{StaticResource PortLensSeparatorBrush}"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Visibility="{Binding ShowAppMetrics, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock Text="{Binding AppVersionText}"
                               Foreground="{StaticResource PortLensTextBrush}"
                               FontSize="13"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="24,8,24,8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding FilteredEntries}">
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                <Expander IsExpanded="True"
                                                          Style="{StaticResource MaterialDesignExpander}"
                                                          BorderBrush="{StaticResource PortLensItemBorderBrush}"
                                                          BorderThickness="0,0,0,1"
                                                          Padding="0"
                                                          Margin="0,0,0,2">
                                                    <Expander.Header>
                                                        <Grid Margin="4,10,6,10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="{Binding Items[0].ProjectGroupTitle}"
                                                                           FontSize="18"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource PortLensGroupTitleBrush}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Items[0].ProjectGroupSubtitle}"
                                                                           Foreground="{StaticResource PortLensSubtitleBrush}"
                                                                           FontSize="12"
                                                                           Margin="0,3,20,0"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1"
                                                                        Orientation="Horizontal"
                                                                        VerticalAlignment="Center">
                                                                <materialDesign:PackIcon Kind="LanConnect"
                                                                                         Width="15"
                                                                                         Height="15"
                                                                                         Foreground="{StaticResource PortLensSubtitleBrush}"
                                                                                         Margin="0,0,5,0" />
                                                                <TextBlock Text="{Binding ItemCount, StringFormat={}{0} ports}"
                                                                           Foreground="{StaticResource PortLensTextBrush}"
                                                                           FontSize="13" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Expander.Header>
                                                    <ItemsPresenter />
                                                </Expander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="Transparent" BorderBrush="{StaticResource PortLensItemBorderBrush}" BorderThickness="0,0,0,1" Padding="0" Margin="0">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Open URL"
                                                  Click="OpenUrlMenuItem_Click"
                                                  Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="OpenInNew" Width="16" Height="16" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Copy URL"
                                                  Click="CopyUrlMenuItem_Click"
                                                  Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="ContentCopy" Width="16" Height="16" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Copy command line"
                                                  Click="CopyCommandLineMenuItem_Click"
                                                  Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="ConsoleLine" Width="16" Height="16" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Open process directory"
                                                  Click="OpenProcessDirectoryMenuItem_Click"
                                                  Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="ApplicationCogOutline" Width="16" Height="16" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Open project directory"
                                                  Click="OpenProjectDirectoryMenuItem_Click"
                                                  Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="FolderOpenOutline" Width="16" Height="16" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Open in terminal"
                                                  Click="OpenTerminalMenuItem_Click"
                                                  Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="Console" Width="16" Height="16" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Add port to blacklist"
                                                  Click="BlacklistPortMenuItem_Click"
                                                  Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="EyeOffOutline" Width="16" Height="16" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Kill process tree"
                                                  Foreground="{StaticResource PortLensDangerBrush}"
                                                  Click="KillProcessTreeMenuItem_Click"
                                                  Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="StopCircleOutline" Width="16" Height="16" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource MaterialDesignExpander}"
                                          Padding="0">
                                    <Expander.Header>
                                        <Grid Margin="4,8,6,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="92" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding PortText}"
                                                       FontFamily="Consolas"
                                                       FontSize="20"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource PortLensPortBrush}"
                                                       VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="1" Margin="2,0,18,0">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="17"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource PortLensGroupTitleBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                                        <materialDesign:PackIcon Kind="ApplicationBracesOutline" Style="{StaticResource MetaIcon}" />
                                                        <TextBlock Text="{Binding FrameworkText}" Foreground="{StaticResource PortLensMetaTextBrush}" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                                        <materialDesign:PackIcon Kind="ClockOutline" Style="{StaticResource MetaIcon}" />
                                                        <TextBlock Text="{Binding UptimeText}" Foreground="{StaticResource PortLensMetaTextBrush}" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                                        <materialDesign:PackIcon Kind="Cpu64Bit" Style="{StaticResource MetaIcon}" />
                                                        <TextBlock Text="{Binding CpuText}" Foreground="{StaticResource PortLensMetaTextBrush}" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Memory" Style="{StaticResource MetaIcon}" />
                                                        <TextBlock Text="{Binding MemoryText}" Foreground="{StaticResource PortLensMetaTextBrush}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource PortActionButton}" Click="OpenButton_Click" Tag="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="OpenInNew" Width="16" Height="16" Margin="0,0,6,0" />
                                                        <TextBlock Text="Open" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource PortActionButton}" Click="CopyButton_Click" Tag="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="ContentCopy" Width="16" Height="16" Margin="0,0,6,0" />
                                                        <TextBlock Text="Copy" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Expander.Header>

                                    <Grid Margin="36,0,6,14">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="50" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,18,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="86" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="PID" Foreground="{StaticResource PortLensDetailLabelBrush}" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ProcessId}" Foreground="{StaticResource PortLensDetailValueBrush}" />

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Address" Foreground="{StaticResource PortLensDetailLabelBrush}" Margin="0,7,0,0" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AddressText}" Foreground="{StaticResource PortLensDetailValueBrush}" Margin="0,7,0,0" />

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Command" Foreground="{StaticResource PortLensDetailLabelBrush}" Margin="0,7,0,0" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CommandText}" Foreground="{StaticResource PortLensDetailValueBrush}" Margin="0,7,0,0" TextWrapping="Wrap" />

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Directory" Foreground="{StaticResource PortLensDetailLabelBrush}" Margin="0,7,0,0" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DirectoryText}" Foreground="{StaticResource PortLensDetailValueBrush}" Margin="0,7,0,0" TextWrapping="Wrap" />
                                        </Grid>

                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                            <Button Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0" Click="OpenDirectoryButton_Click" Tag="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="FolderOpenOutline" Width="16" Height="16" Margin="0,0,6,0" />
                                                    <TextBlock Text="Directory" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0" Click="CopyPidButton_Click" Tag="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Identifier" Width="16" Height="16" Margin="0,0,6,0" />
                                                    <TextBlock Text="PID" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="{StaticResource PortLensDangerBrush}" Click="KillButton_Click" Tag="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="StopCircleOutline" Width="16" Height="16" Margin="0,0,6,0" />
                                                    <TextBlock Text="Kill" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <Grid Grid.Row="1" Grid.Column="2" Width="50" IsHitTestVisible="False" Opacity="0" />
                                    </Grid>
                                </Expander>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                <materialDesign:PackIcon Kind="LanDisconnect" Width="48" Height="48" Foreground="{StaticResource PortLensEmptyIconBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="No development services found" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PortLensEmptyTitleBrush}" Margin="0,12,0,0" />
                <TextBlock Text="Start a dev server, or enable System ports." Foreground="{StaticResource PortLensEmptySubtitleBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>
    </DockPanel>
    <materialDesign:Snackbar MessageQueue="{Binding SnackbarMessageQueue}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Bottom"
                             Margin="24,0,24,44" />
    </Grid>
    </materialDesign:DialogHost>
</Window>
