<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PortLens</AssemblyName>
    <RootNamespace>PortLens.Desktop</RootNamespace>
    <ApplicationIcon>Assets\portlens-icon.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PortLens.Core\PortLens.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\portlens-icon.ico" />
    <Resource Include="Assets\portlens-icon.png" />
  </ItemGroup>
</Project>
